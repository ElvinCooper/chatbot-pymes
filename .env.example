# Configuración de providers del chatbot.
# Copia este archivo a .env y completa SOLO las keys que tengas.
# Los providers sin key se ignoran automáticamente (el chatbot usa fallback).

# Groq (el más recomendado: gratis y rápido) -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (acceso a muchos modelos, incl. gratis) -> https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token del bot de Telegram (obtener con @BotFather) -> https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Secreto compartido para validar el webhook (se envía como header
# X-Telegram-Bot-Api-Secret-Token al registrar el webhook con setWebhook).
# Vacío = no se valida el origen (no recomendado en producción).
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Business (Cloud API de Meta) -----------------------------------
# Te dejan las credenciales en: app -> WhatsApp -> API Setup
#   WHATSAPP_PHONE_NUMBER_ID  -> ID del número de teléfono del negocio
#   WHATSAPP_ACCESS_TOKEN     -> token temporal (24h) o permanente (system user)
# WHATSAPP_APP_SECRET  -> App Settings > Basic. Valida la firma X-Hub-Signature-256
#                        de cada update (headera X-Hub-Signature-256).
# WHATSAPP_VERIFY_TOKEN -> cadena cualquiera que elijas; debe coincidir con la
#                         que pegas en el panel de Meta (WhatsApp > Configuration
#                         > Webhook). DISTINTO del App Secret.

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# URL base interna del chatbot. Se documenta para un despliegue desacoplado
# (el webhook consumiría /chat por HTTP). En el mismo proceso no se usa.
CHATBOT_API_URL=http://127.0.0.1:8001

# --- Servicio de documentos (document-service) --------------------------------
# Genera cotizaciones en PDF vía POST /quotes. URL base del microservicio y la
# misma INTERNAL_API_KEY configurada en su .env (cabecera X-Internal-API-Key).
DOCUMENT_SERVICE_URL=http://document-service:8000
INTERNAL_API_KEY=

# Servicio de correos (email-service), en el puerto publicado 8003.
# Si el chatbot también corre en Docker, usa http://email-service:8003.
# La clave es DISTINTA de INTERNAL_API_KEY: cada microservicio tiene la suya.
EMAIL_SERVICE_URL=http://127.0.0.1:8003
EMAIL_SERVICE_API_KEY=
