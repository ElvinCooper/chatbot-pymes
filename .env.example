# Configuración de providers del chatbot.
# Copia este archivo a .env y completa SOLO las keys que tengas.
# Los providers sin key se ignoran automáticamente (el chatbot usa fallback).

# Groq (el más recomendado: gratis y rápido) -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (acceso a muchos modelos, incl. gratis) -> https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token del bot de Telegram (obtener con @BotFather) -> https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Secreto compartido para validar el webhook (se envía como header
# X-Telegram-Bot-Api-Secret-Token al registrar el webhook con setWebhook).
# Vacío = no se valida el origen (no recomendado en producción).
# El endpoint ahora devuelve 503 si el secreto está vacío.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Business (Cloud API de Meta) -----------------------------------
# Te dejan las credenciales en: app -> WhatsApp -> API Setup
#   WHATSAPP_PHONE_NUMBER_ID  -> ID del número de teléfono del negocio
#   WHATSAPP_ACCESS_TOKEN     -> token temporal (24h) o permanente (system user)
# WHATSAPP_APP_SECRET  -> App Settings > Basic. Valida la firma X-Hub-Signature-256
#                        de cada update (headera X-Hub-Signature-256).
# WHATSAPP_VERIFY_TOKEN -> cadena cualquiera que elijas; debe coincidir con la
#                         que pegas en el panel de Meta (WhatsApp > Configuration
#                         > Webhook). DISTINTO del App Secret.

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# --- Facebook Messenger (Messenger Platform de Meta) --------------------------
# Pueden compartir app con WhatsApp o ser otra: se guardan con nombres
# independientes para que no cambien nada al migrar de app.
#   MESSENGER_PAGE_ID        -> ID numérico de tu Página de Facebook (Apps > Página
#                               o Graph API /me). Identifica al emisor y sirve para
#                               detectar los propios mensajes (ecos) que devuelve Meta.
#   MESSENGER_ACCESS_TOKEN   -> token de la Página, generado en el Centro de
#                               estados y con el permiso "pages_messaging".
#                               (Apps > WhatsApp > API Setup te lo muestra aunque
#                               lo use Messenger; revisa también la pestaña de la Página)
#   MESSENGER_APP_SECRET     -> App Settings > Basic. Valida X-Hub-Signature-256 igual
#                               que WhatsApp. Si la app es la misma, puede ser el mismo
#                               valor que WHATSAPP_APP_SECRET.
#   MESSENGER_VERIFY_TOKEN   -> cadena cualquiera que elijas; debe coincidir con la que
#                               pegas en el panel de Meta (Webhooks). DISTINTO del App Secret.
# El bot solo responde a mensajes recibidos hace menos de 24 h (ventana de Meta).

MESSENGER_PAGE_ID=
MESSENGER_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# URL base interna del chatbot. Se documenta para un despliegue desacoplado
# (el webhook consumiría /chat por HTTP). En el mismo proceso no se usa.
CHATBOT_API_URL=http://127.0.0.1:8001

# --- Servicio de documentos (document-service) --------------------------------
# Genera cotizaciones en PDF vía POST /quotes. URL base del microservicio y la
# misma INTERNAL_API_KEY configurada en su .env (cabecera X-Internal-API-Key).
DOCUMENT_SERVICE_URL=http://document-service:8000
INTERNAL_API_KEY=

# Servicio de correos (email-service), en el puerto publicado 8003.
# Si el chatbot también corre en Docker, usa http://email-service:8003.
# La clave es DISTINTA de INTERNAL_API_KEY: cada microservicio tiene la suya.
EMAIL_SERVICE_URL=http://127.0.0.1:8003
EMAIL_SERVICE_API_KEY=

# --- Métricas de uso (Fases 0 y 2) ---------------------------------------------
# Registro de llamadas LLM y eventos de canal WhatsApp en SQLite (tablas
# usage_events y whatsapp_message_status de metrics.sqlite3).
# TENANT_ID: identificador del negocio para los eventos. Por defecto "chatbot"
# (el mismo tenant actual de cotizaciones). La multi-tenancy completa NO existe.
TENANT_ID=chatbot

# Ruta de la BD de métricas (runtime, gitignored). Default: metrics.sqlite3
METRICS_DB_PATH=runtime/metrics.sqlite3

# --- Costes y rentabilidad (Fase 3) -------------------------------------------
# Mercado de WhatsApp para el costeo (tarifas de Meta). Default: rest_of_latam
# (RD +1 809/829/849 no es mercado standalone: cae en "Rest of Latin America").
# Las tarifas por modelo/mensaje viven en la tabla `tariffs`; el informe se
# genera con: python -m app.cli.cost_report --period YYYY-MM
WHATSAPP_MARKET=rest_of_latam

# --- Seguridad de la API ----------------------------------------------------
# Generar claves con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# No reutilizar claves del document-service, correo o proveedores LLM.
# Bearer para administración, mínimo 32 caracteres. Vacío = acceso cerrado.
ADMIN_API_KEY=
# Un identificador y una clave distinta por cliente; NO compartir claves.
# JSON: {"cliente1":"<clave de al menos 32 caracteres>"}
API_CLIENT_KEYS={}
# Cotizaciones y métricas usan el único TENANT_ID configurado arriba.
QUOTE_CATALOG_PATH=data/quote_catalog.json

# Inbox durable compartida por procesos de canales, fuera de Git y backups públicos.
INBOX_DB_PATH=runtime/inbox.sqlite3
RAG_DB_PATH=runtime/rag.sqlite3
# Scripts fijan telegram/whatsapp/messenger; all para una instancia con todos.
BOT_CHANNEL=all
# Cuotas globales, compartidas por la inbox: reserva antes de cada llamada.
LLM_CALLS_PER_DAY=1000
# Reserva conservadora de bytes de entrada + límite de salida; NO modifica usage.
LLM_TOKEN_BUDGET_PER_DAY=1000000
IDLE_CLOSE_SECONDS=600
IDLE_CHECK_INTERVAL=20

# Directorio de bases/logs. Las rutas relativas se resuelven desde la raíz del proyecto.
RUNTIME_DIR=runtime
