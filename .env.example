# Configuración de providers del chatbot.
# Copia este archivo a .env y completa SOLO las keys que tengas.
# Los providers sin key se ignoran automáticamente (el chatbot usa fallback).

# Groq (el más recomendado: gratis y rápido) -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (acceso a muchos modelos, incl. gratis) -> https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token del bot de Telegram (obtener con @BotFather) -> https://t.me/BotFather
TELEGRAM_BOT_TOKEN=